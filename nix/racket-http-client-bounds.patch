+(define HEADER-LIMIT (* 16 1024))
+;; Bound framing before allocation; existing HTTP parsing remains unchanged.
+(define (bounded-line in limit)
+  (define buffer (make-bytes limit))
+  (let loop ([n 0])
+    (define byte (read-byte in))
+    (cond
+      [(eof-object? byte) (error 'http-client "Incomplete HTTP framing")]
+      [(= byte 10)
+       (subbytes buffer 0 (if (and (positive? n) (= (bytes-ref buffer (sub1 n)) 13)) (sub1 n) n))]
+      [(= n limit) (error 'http-client "HTTP framing exceeds bound")]
+      [else (bytes-set! buffer n byte) (loop (add1 n))])))
