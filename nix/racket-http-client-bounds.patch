+(define (bounded-headers in)
+  (let loop ([remaining HEADER-LIMIT] [count 0])
+    (when (< remaining 2) (error 'http-client "HTTP headers exceed bound"))
+    (define top (bounded-line in remaining))
+    (cond [(bytes=? top #"") empty]
+          [(>= count 32) (error 'http-client "HTTP header count exceeds bound")]
+          [else
+           (define fields (regexp-match #px#"^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*([^\r\n]*)$" top))
+           (unless fields (error 'http-client "Invalid HTTP header"))
+           ;; Canonical separator keeps http-easy's header lookup authoritative
+           ;; even when a peer omits optional whitespace after the colon.
+           (define header (bytes-append (cadr fields) #": " (regexp-replace #px#"[ \t]+$" (caddr fields) #"")))
+           (cons header (loop (- remaining (bytes-length top) 2) (add1 count)))])))
 
